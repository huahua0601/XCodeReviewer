# ==========================================
# XCodeReviewer Backend 环境变量配置示例
# ==========================================
# 复制此文件为 .env 并填写实际配置

# ==========================================
# 应用配置
# ==========================================
APP_NAME=XCodeReviewer
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# ==========================================
# 外部数据库配置
# ==========================================
# PostgreSQL 连接字符串 (外部数据库)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@xx.xx.xx.xx:5432/
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# ==========================================
# 外部 Redis 配置
# ==========================================
# Redis 连接字符串 (外部 Redis)
REDIS_URL=redis://xxxx:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5

# Celery 配置 (使用外部 Redis)
CELERY_BROKER_URL=redis://xxxxxx:6379/1
CELERY_RESULT_BACKEND=redis://xxxxx:6379/2
CELERY_WORKER_CONCURRENCY=4

# ==========================================
# 安全配置
# ==========================================
# 使用以下命令生成密钥:
# python -c "import secrets; print(secrets.token_urlsafe(32))"

SECRET_KEY=x67Kh7UEsI2ga8K5bPWjkGvz2BUuJ0CjIiCWKso5Uj0
JWT_SECRET_KEY=x67Kh7UEsI2ga8K5bPWjkGvz2BUuJ0CjIiCWKso5Uj0
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=8

# ==========================================
# 存储配置
# ==========================================
STORAGE_TYPE=minio
LOCAL_STORAGE_PATH=./storage

# MinIO 配置 (Docker Compose 内部服务)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=xcodereviewer
MINIO_SECURE=false

# ==========================================
# LLM 配置
# ==========================================
LLM_MODE=production

# Ollama (如果使用)
OLLAMA_BASE_URL=http://localhost:11434

# ==========================================
# 外部集成
# ==========================================
# GitHub
GITHUB_TOKEN=

# GitLab
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.com


# ==========================================
# 监控配置
# ==========================================
ENABLE_METRICS=true
METRICS_PORT=9090

# ==========================================
# 性能配置
# ==========================================
WORKERS=4
GUNICORN_TIMEOUT=120
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ==========================================
# Flower 监控配置
# ==========================================
FLOWER_USER=admin
FLOWER_PASSWORD=admin
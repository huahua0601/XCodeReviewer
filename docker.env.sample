# ==========================================
# XCodeReviewer 环境变量配置示例
# ==========================================
# 复制此文件为 .env 并填写实际配置

# ==========================================
# 前端配置
# ==========================================

# LLM 通用配置
VITE_LLM_PROVIDER=gemini
VITE_LLM_API_KEY=your_api_key_here
VITE_LLM_MODEL=
VITE_LLM_BASE_URL=
VITE_LLM_TIMEOUT=150000
VITE_LLM_TEMPERATURE=0.2
VITE_LLM_MAX_TOKENS=4096

# Google Gemini 配置
VITE_GEMINI_API_KEY=your_gemini_api_key
VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_GEMINI_TIMEOUT_MS=25000

# OpenAI 配置
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4o-mini
VITE_OPENAI_BASE_URL=

# Claude 配置
VITE_CLAUDE_API_KEY=
VITE_CLAUDE_MODEL=claude-3-5-sonnet-20241022

# 通义千问配置
VITE_QWEN_API_KEY=
VITE_QWEN_MODEL=qwen-turbo

# DeepSeek 配置
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_MODEL=deepseek-chat

# 智谱AI 配置
VITE_ZHIPU_API_KEY=
VITE_ZHIPU_MODEL=glm-4-flash

# Moonshot 配置
VITE_MOONSHOT_API_KEY=
VITE_MOONSHOT_MODEL=moonshot-v1-8k

# 百度文心一言配置
VITE_BAIDU_API_KEY=
VITE_BAIDU_MODEL=ERNIE-3.5-8K

# MiniMax 配置
VITE_MINIMAX_API_KEY=
VITE_MINIMAX_MODEL=abab6.5-chat

# 豆包配置
VITE_DOUBAO_API_KEY=
VITE_DOUBAO_MODEL=doubao-pro-32k

# Ollama 配置
VITE_OLLAMA_API_KEY=ollama
VITE_OLLAMA_MODEL=llama3
VITE_OLLAMA_BASE_URL=http://localhost:11434/v1

# 数据库配置
VITE_USE_LOCAL_DB=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GitHub 配置
VITE_GITHUB_TOKEN=

# 应用配置
VITE_APP_ID=xcodereviewer
VITE_MAX_ANALYZE_FILES=40
VITE_LLM_CONCURRENCY=2
VITE_LLM_GAP_MS=500
VITE_OUTPUT_LANGUAGE=zh-CN

# ==========================================
# 后端配置 (在 backend/.env 中配置)
# ==========================================

# 应用环境
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# 外部 PostgreSQL 数据库配置
DATABASE_URL=postgresql+asyncpg://username:password@your-postgres-host:5432/xcodereviewer
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# 外部 Redis 配置
REDIS_URL=redis://your-redis-host:6379/0
CELERY_BROKER_URL=redis://your-redis-host:6379/1
CELERY_RESULT_BACKEND=redis://your-redis-host:6379/2

# 安全配置
SECRET_KEY=your_secret_key_here_min_32_chars
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MinIO 配置 (Docker Compose 内部服务)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=xcodereviewer
STORAGE_TYPE=minio

# LLM 配置
LLM_MODE=production
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# GitHub/GitLab 配置
GITHUB_TOKEN=
GITLAB_TOKEN=
GITLAB_URL=https://gitlab.com

# Flower 监控配置
FLOWER_USER=admin
FLOWER_PASSWORD=admin

# Celery 配置
CELERY_WORKER_CONCURRENCY=4

# 性能配置
WORKERS=4
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

